{
  "name": "hyper-twitch",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wxt build",
    "dev": "wxt",
    "fix": "oxlint --fix && pnpm run format",
    "format": "oxfmt",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "git config core.hooksPath .githooks && wxt prepare",
    "lint": "eslint && oxlint",
    "precommit": "pnpm run fix && eslint",
    "test": "vitest run",
    "zip": "wxt zip"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "catalog:",
    "@typescript/native-preview": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-oxlint": "catalog:",
    "happy-dom": "catalog:",
    "lint-staged": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "sort-package-json": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:",
    "wxt": "catalog:"
  },
  "packageManager": "pnpm@11.1.1"
}
